COHERE_API_KEY=your_real_key_here

# Optional. Defaults to command-r-plus-08-2024.
# COHERE_MODEL=command-r-plus-08-2024

# --- Supabase -----------------------------------------------------------------
#
# Required by /api/adaptive-question, /api/recommendation, /api/follow-up and
# /api/complete-chat. Without them those routes fail and the rest of the service
# still runs.
#
# Project Settings -> API. The SERVICE ROLE key, not the anon/publishable one:
# this service reads a chat's context and writes the model's turns back, and it
# is not acting as any single user when it does.
#
# The service-role key bypasses Row Level Security entirely. It is a master key
# to every row in the database.
#   - Never put it in the Flutter app, a client build, or a public repo.
#   - Set it in Render's environment, not in a file you commit.
#   - If it leaks, rotate it in Supabase immediately.
#
# Because it bypasses RLS, this service does the authorisation the database can
# no longer do: every request carries the caller's Supabase access token, and the
# chat must belong to them. See app/core/auth.py.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Web search ---------------------------------------------------------------
#
# The recommendation call decides for itself whether a question turns on current
# real-world facts, and only searches when it does. DuckDuckGo, so no key and no
# billing account — but it rate-limits and has no SLA, so a failed search is
# treated as "no results" rather than an error.
#
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_RESULTS=4

# --- Adaptive questioning -----------------------------------------------------
#
# Hard ceiling on generated questions per chat. The model stops on its own when
# it has enough — usually after 3-6 — so this only catches one that would
# interview someone forever.
# MAX_ADAPTIVE_ROUNDS=8

# --- Long-term memory ---------------------------------------------------------
#
# Facts kept per user_memory row (one global row per user, plus one per
# category). Memory grows for the life of an account and is read in front of
# every generated question, so it needs a ceiling — but the number is a
# backstop, not a target. The prompt's own bar for what is worth remembering is
# what actually keeps this small; this only catches a model that has decided to
# transcribe.
# MEMORY_MAX_FACTS=30

# Comma-separated origins allowed to call the API. Defaults to "*" when unset.
# ALLOWED_ORIGINS=https://thoughtloom.app,http://localhost:8080
